{
  "name": "pi-websearch",
  "version": "0.1.0",
  "description": "Web search tools for pi backed by a self-hosted SearXNG instance.",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "extensions",
    "web",
    "search",
    "searxng"
  ],
  "license": "MIT",
